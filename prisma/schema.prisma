// Prisma schema — Phase 1+2 scope (TDD "Ngày 1").
// Only `users` and `refresh_tokens` are modeled here, matching the
// Identity Module. Full schema (tickets, conversations, knowledge base,
// rag, escalation, audit, etc. — see TDD Mục 10) will be added
// incrementally in Phase 3+ once each module's architecture is approved.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMIN
  AGENT
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens   RefreshToken[]
  assignedTickets Ticket[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================================
// Phase 3+4 — Customer / Ticket / Conversation / Knowledge Base
// (TDD Mục 10). RAG/embedding columns (chunk_embeddings, pgvector
// vector column...) are deliberately NOT added yet — Phase 5.
// ============================================================

enum Channel {
  WEB
  EMAIL
  CHAT_APP
  INTERNAL
}

enum TicketStatus {
  NEW
  CLASSIFIED
  WAITING_CUSTOMER
  ANSWERED
  ESCALATED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageSender {
  CUSTOMER
  AGENT
  AI
}

enum TurnRole {
  USER
  ASSISTANT
  SYSTEM
}

enum DocumentSourceType {
  FILE
  URL
  TEXT
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Customer {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  phone       String?
  metadata    Json?
  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  tickets Ticket[]

  @@map("customers")
}

model Ticket {
  id               String         @id @default(uuid())
  customerId       String         @map("customer_id")
  channel          Channel
  subject          String
  status           TicketStatus   @default(NEW)
  category         String?
  priority         PriorityLevel?
  confidenceScore  Float?         @map("confidence_score")
  assignedAgentId  String?        @map("assigned_agent_id")
  isSpam           Boolean        @default(false) @map("is_spam")
  isDuplicateOf    String?        @map("is_duplicate_of")
  missingInfoFlags String[]       @default([]) @map("missing_info_flags")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  resolvedAt       DateTime?      @map("resolved_at")

  customer      Customer              @relation(fields: [customerId], references: [id])
  assignedAgent User?                 @relation(fields: [assignedAgentId], references: [id])
  duplicateOf   Ticket?               @relation("TicketDuplicate", fields: [isDuplicateOf], references: [id])
  duplicates    Ticket[]              @relation("TicketDuplicate")
  messages      TicketMessage[]
  statusHistory TicketStatusHistory[]
  conversation  Conversation?

  @@index([status])
  @@index([customerId])
  @@index([assignedAgentId])
  @@index([createdAt])
  @@index([status, priority])
  @@map("tickets")
}

model TicketMessage {
  id              String        @id @default(uuid())
  ticketId        String        @map("ticket_id")
  sender          MessageSender
  content         String
  attachments     String[]      @default([])
  channelMetadata Json?         @map("channel_metadata")
  createdAt       DateTime      @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketStatusHistory {
  id         String       @id @default(uuid())
  ticketId   String       @map("ticket_id")
  fromStatus TicketStatus @map("from_status")
  toStatus   TicketStatus @map("to_status")
  changedBy  String       @map("changed_by")
  reason     String?
  changedAt  DateTime     @default(now()) @map("changed_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, changedAt])
  @@map("ticket_status_history")
}

model Conversation {
  id             String   @id @default(uuid())
  ticketId       String   @unique @map("ticket_id")
  summary        String?
  turnCount      Int      @default(0) @map("turn_count")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  ticket Ticket             @relation(fields: [ticketId], references: [id])
  turns  ConversationTurn[]

  @@map("conversations")
}

model ConversationTurn {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           TurnRole
  content        String
  tokensEstimate Int      @default(0) @map("tokens_estimate")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("conversation_turns")
}

model KnowledgeDocument {
  id         String             @id @default(uuid())
  title      String
  sourceType DocumentSourceType @map("source_type")
  filePath   String?            @map("file_path")
  status     DocumentStatus     @default(PENDING)
  version    Int                @default(1)
  tags       String[]           @default([])
  uploadedBy String             @map("uploaded_by")
  createdAt  DateTime           @default(now()) @map("created_at")
  deletedAt  DateTime?          @map("deleted_at")

  chunks KnowledgeChunk[]

  @@index([status])
  @@index([uploadedBy])
  @@map("knowledge_documents")
}

// ============================================================
// Phase 5 — RAG Pipeline (TDD Mục 7 & 10.3). `ChunkEmbedding`
// tách bảng riêng khỏi `KnowledgeChunk` (cho phép nhiều embedding/model
// khác nhau trong tương lai mà không phá vỡ dữ liệu chunk gốc). Cột
// `vector` dùng kiểu Postgres thật (pgvector) qua Unsupported() vì
// Prisma Client chưa hỗ trợ thao tác trực tiếp — mọi đọc/ghi vector đi
// qua raw SQL ở `PrismaChunkRepository` (Mục 5.6 — 🔌 IVectorStore).
// ============================================================

model KnowledgeChunk {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  content    String
  chunkIndex Int      @map("chunk_index")
  tokenCount Int      @map("token_count")
  section    String?
  createdAt  DateTime @default(now()) @map("created_at")

  document  KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embedding ChunkEmbedding?

  @@index([documentId])
  @@map("knowledge_chunks")
}

model ChunkEmbedding {
  chunkId        String                 @id @map("chunk_id")
  vector         Unsupported("vector")?
  embeddingModel String                 @map("embedding_model")
  dimensions     Int
  createdAt      DateTime               @default(now()) @map("created_at")

  chunk KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("chunk_embeddings")
}
