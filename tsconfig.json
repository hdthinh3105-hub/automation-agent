{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@app/shared": ["libs/shared/index.ts"],
      "@app/shared/*": ["libs/shared/*"],
      "@app/config": ["libs/config/index.ts"],
      "@app/config/*": ["libs/config/*"],
      "@app/infrastructure": ["libs/infrastructure/index.ts"],
      "@app/infrastructure/*": ["libs/infrastructure/*"],
      "@app/modules/identity": ["libs/modules/identity/index.ts"],
      "@app/modules/identity/*": ["libs/modules/identity/*"],
      "@app/modules/customer": ["libs/modules/customer/index.ts"],
      "@app/modules/customer/*": ["libs/modules/customer/*"],
      "@app/modules/ticket": ["libs/modules/ticket/index.ts"],
      "@app/modules/ticket/*": ["libs/modules/ticket/*"],
      "@app/modules/conversation": ["libs/modules/conversation/index.ts"],
      "@app/modules/conversation/*": ["libs/modules/conversation/*"],
      "@app/modules/knowledge-base": ["libs/modules/knowledge-base/index.ts"],
      "@app/modules/knowledge-base/*": ["libs/modules/knowledge-base/*"]
    }
  }
}
