# ==============================================
# AI Customer Support Automation - ENV EXAMPLE
# ==============================================

# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3001

# ---- Database (PostgreSQL + pgvector) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_customer_support?schema=public

# ---- Redis (BullMQ — REQUIRED từ Phase 5, dùng cho Document Parser + Embedding Worker) ----
# Dùng Upstash free tier: lấy Host/Port/Password ở Upstash Console -> Database -> Details.
# REDIS_TLS phải = true với Upstash (và hầu hết managed Redis free-tier khác).
# Redis local/Docker (redis:7-alpine) thì để REDIS_TLS=false.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ---- JWT / Auth (REQUIRED) ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# ---- Logging ----
LOG_LEVEL=info

# ---- File Storage ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# ==============================================
# Phase 5 — RAG Pipeline
# ==============================================

# ---- LLM Providers ----
# Không bắt buộc để BOOT app (Đợt 1 chỉ dùng Embedding, chưa gọi LLM
# generate/summarize) — nhưng BẮT BUỘC nếu bạn thực sự gọi
# LlmOrchestratorProvider (Đợt 2 — Answer Generation), vì lúc đó
# orchestrator sẽ throw lỗi rõ ràng nếu cả 2 key đều trống.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Embedding ----
# "local" (mặc định, KHÔNG cần API key — chạy bge-small qua
# @xenova/transformers, model tự tải + cache ở lần embed đầu tiên) hoặc
# "gemini" (cần GEMINI_API_KEY, dùng text-embedding-004, 768 chiều).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ---- Chunking / Retrieval strategy (config-driven, TDD Mục 2.7) ----
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RAG_TOP_K_RETRIEVAL=15
RAG_TOP_K_FINAL=5
RAG_EMBEDDING_BATCH_SIZE=16

# ---- AI thresholds (Phase 6+, đã dùng lại ở Confidence Scoring Đợt 2) ----
AI_CONFIDENCE_ESCALATION_THRESHOLD=0.6
SPAM_SCORE_THRESHOLD=0.8

# ---- Email (Phase 8+) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@example.com

# ---- Telegram channel (Phase 6+) ----
TELEGRAM_BOT_TOKEN=
