# ==============================================
# AI Customer Support Automation - ENV EXAMPLE
# Phase 1+2 scope: only vars needed for Setup + Auth are required.
# Vars for later phases (LLM/RAG/etc.) are listed but optional for now.
# ==============================================

# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3001

# ---- Database (PostgreSQL + pgvector) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_customer_support?schema=public

# ---- Redis (BullMQ) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT / Auth (REQUIRED in Phase 1+2) ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# ---- Logging ----
LOG_LEVEL=info

# ==============================================
# Below: NOT required for Phase 1+2, reserved for later Phases (3-11)
# ==============================================

# ---- LLM Providers (Phase 5+) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Embedding (Phase 5+) ----
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- AI thresholds (Phase 6+) ----
AI_CONFIDENCE_ESCALATION_THRESHOLD=0.6
SPAM_SCORE_THRESHOLD=0.8

# ---- Email (Phase 8+) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@example.com

# ---- Telegram channel (Phase 6+) ----
TELEGRAM_BOT_TOKEN=

# ---- File Storage (Phase 4+) ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
